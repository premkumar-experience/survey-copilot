# Survey Copilot — environment template
#
# Copy to .env.local and fill in. .env.local is git-ignored; never commit a key.
#
#   cp .env.example .env.local

# auto | claude | mock
#   auto   -> Claude when ANTHROPIC_API_KEY is set, otherwise Mock AI
#   claude -> force Claude
#   mock   -> force Mock AI (no API key needed)
AI_PROVIDER=auto

# Server-side only. Leave blank to run entirely on Mock AI.
ANTHROPIC_API_KEY=

# --- Access control (optional) --------------------------------------------
#
# Set both to require a login. Leave blank and the app runs open, which is
# fine locally but NOT on a public deployment: without these, anyone with the
# URL can read every survey and spend the Anthropic key above.
#
# One shared username/password for everyone — there are no user accounts.
# Changing them invalidates existing sessions.
AUTH_USERNAME=
AUTH_PASSWORD=

# Optional. Signs the session cookie; defaults to AUTH_PASSWORD when unset.
# Set it to any long random string if you want sessions to survive a
# password change.
AUTH_SECRET=

# --- Survey storage (optional) -------------------------------------------
#
# Leave both blank to run entirely in memory: surveys live in React state for
# the session and are lost on refresh, which is how the app behaves with no
# Supabase project. Every AI feature works either way.
#
# Set both to persist surveys. Run supabase/schema.sql in the SQL editor
# first. Server-side only — note neither is NEXT_PUBLIC_*, because the service
# role key bypasses row-level security and must never reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
